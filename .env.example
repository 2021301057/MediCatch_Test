# ── 데이터베이스 ────────────────────────────────────
MYSQL_ROOT_PASSWORD=medicatch123

# ── JWT ───────────────────────────────────────────
JWT_SECRET=medicatch-jwt-secret-key-2026-change-this-in-production-min-64chars-required

# ── CODEF API ─────────────────────────────────────
# https://developer.codef.io 에서 발급
CODEF_API_CLIENT_ID=your_codef_api_client_id
CODEF_API_CLIENT_SECRET=your_codef_api_client_secret
CODEF_DEMO_CLIENT_ID=your_codef_demo_client_id
CODEF_DEMO_CLIENT_SECRET=your_codef_demo_client_secret
CODEF_PUBLIC_KEY=your_codef_rsa_public_key
CODEF_USE_DEMO=true

# ── AI API (건강 채팅 + 진료 전 검색 분류) ────────
# Groq (기본): https://console.groq.com/keys 에서 발급
# Gemini:     https://aistudio.google.com/apikey 에서 발급
# OpenAI:     https://platform.openai.com/api-keys 에서 발급
AI_API_KEY=your_ai_api_key
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=https://api.groq.com/openai/v1

# ── 프론트엔드 빌드 ────────────────────────────────
# 기본값 /api: 프론트 nginx가 /api/ → gateway-service:8000으로 내부 프록시
# (같은 origin이라 CORS 불필요, KT IP 바뀌어도 재빌드 불필요)
# 로컬 개발 시 별도 host:port가 필요하면 http://localhost:8000/api 등으로 덮어쓰기
REACT_APP_API_BASE_URL=/api

# 카카오지도 JavaScript 키 — https://developers.kakao.com 내 애플리케이션 > 앱 키
# (카카오 콘솔에 서비스 도메인 등록 필요)
REACT_APP_KAKAO_MAP_KEY=your_kakao_javascript_key
